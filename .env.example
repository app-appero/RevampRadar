# Backend
# URL del Postgres usato dall'API in Docker. Vuoto = database locale (avvia con `--profile localdb`).
# Con il Postgres su Railway: DATABASE_PUBLIC_URL con schema postgresql+psycopg:// e ?sslmode=require
# API_DATABASE_URL=
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://revampradar:revampradar@localhost:5433/revampradar
CORS_ORIGINS=http://localhost:1420,http://localhost:5173,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost
PAGESPEED_API_KEY=
# Basic Auth opzionale (obbligatoria se il backend è pubblico, es. Railway). Vuote = disattivata.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# AI qualitativa (UX/copy/proposta). Switch: claude | openai. Default claude.
# Senza la chiave del provider scelto, audit e score deterministici restano validi.
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=90

# Desktop (Vite)
VITE_API_BASE_URL=http://localhost:8000
# Backend remoto (Railway): abilita il pulsante "Locale → Remoto" nell'header dell'app.
# VITE_API_REMOTE_URL=https://<tuo-servizio>.up.railway.app
# "utente:password", stessi valori di BASIC_AUTH_USER/PASSWORD impostati su Railway
# VITE_API_BASIC_AUTH=
