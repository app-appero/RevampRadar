# Backend
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://revampradar:revampradar@localhost:5433/revampradar
CORS_ORIGINS=http://localhost:1420,http://localhost:5173,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost
PAGESPEED_API_KEY=

# AI qualitativa (UX/copy/proposta). Switch: claude | openai. Default claude.
# Senza la chiave del provider scelto, audit e score deterministici restano validi.
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=90

# Desktop (Vite)
VITE_API_BASE_URL=http://localhost:8000
